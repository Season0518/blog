{
  "name": "Hatsune Miku",
  "type": "dark",
  "colors": {
    "editor.background": "#1A1F24",
    "editor.foreground": "#DEE8F2"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#8DC6B6"
      }
    },
    {
      "name": "Documentation Comments",
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation",
        "comment.block.javadoc",
        "storage.type.class.jsdoc"
      ],
      "settings": {
        "foreground": "#85BCAD",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Control Keywords",
      "scope": ["keyword.control"],
      "settings": {
        "foreground": "#66F3D3"
      }
    },
    {
      "name": "Storage Types",
      "scope": ["storage.type"],
      "settings": {
        "foreground": "#66F3D3"
      }
    },
    {
      "name": "Storage Modifiers",
      "scope": ["storage.modifier"],
      "settings": {
        "foreground": "#66F3D3"
      }
    },
    {
      "name": "Keyword Declaration",
      "scope": [
        "keyword.declaration",
        "keyword.declaration.function",
        "keyword.declaration.class",
        "keyword.declaration.type"
      ],
      "settings": {
        "foreground": "#66F3D3"
      }
    },
    {
      "name": "Keyword Other",
      "scope": ["keyword.other", "keyword.other.unit"],
      "settings": {
        "foreground": "#66F3D3"
      }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator", "keyword.operator.ternary"],
      "settings": {
        "foreground": "#FFB7FF"
      }
    },
    {
      "name": "Special Operators",
      "scope": [
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.spread",
        "keyword.operator.rest"
      ],
      "settings": {
        "foreground": "#66F3D3"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#7AD7C0"
      }
    },
    {
      "name": "User Functions",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "meta.function-call.generic"
      ],
      "settings": {
        "foreground": "#FFC39B"
      }
    },
    {
      "name": "Library/Support Functions",
      "scope": [
        "support.function",
        "support.function.console",
        "support.function.builtin"
      ],
      "settings": {
        "foreground": "#FFC492"
      }
    },
    {
      "name": "Methods",
      "scope": [
        "entity.name.function.member",
        "meta.method.declaration",
        "meta.function.method"
      ],
      "settings": {
        "foreground": "#FFC39B"
      }
    },
    {
      "name": "Function Call Arguments",
      "scope": ["meta.function-call.arguments", "meta.function.arguments"],
      "settings": {
        "foreground": "#27F1FC"
      }
    },
    {
      "name": "User Classes",
      "scope": ["entity.name.type.class", "entity.name.class"],
      "settings": {
        "foreground": "#E9D27B"
      }
    },
    {
      "name": "Structs",
      "scope": ["entity.name.type.struct"],
      "settings": {
        "foreground": "#E4D28E"
      }
    },
    {
      "name": "Support/Library Classes",
      "scope": ["support.class"],
      "settings": {
        "foreground": "#E9D27B"
      }
    },
    {
      "name": "Support/Built-in Types",
      "scope": ["support.type"],
      "settings": {
        "foreground": "#C9D0FF"
      }
    },
    {
      "name": "Interfaces",
      "scope": ["entity.name.type.interface", "entity.name.interface"],
      "settings": {
        "foreground": "#8DF0B1"
      }
    },
    {
      "name": "Enums",
      "scope": ["entity.name.type.enum", "entity.name.enum"],
      "settings": {
        "foreground": "#E9D27B"
      }
    },
    {
      "name": "Types / Primitives",
      "scope": [
        "entity.name.type",
        "support.type.primitive",
        "support.type.builtin"
      ],
      "settings": {
        "foreground": "#C9D0FF"
      }
    },
    {
      "name": "Type Parameters",
      "scope": ["entity.name.type.parameter"],
      "settings": {
        "foreground": "#CDD3FF"
      }
    },
    {
      "name": "Type Alias",
      "scope": ["entity.name.type.alias", "entity.name.type.type-alias"],
      "settings": {
        "foreground": "#C9D0FF"
      }
