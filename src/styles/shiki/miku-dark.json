    {
      "name": "Namespaces",
      "scope": [
        "entity.name.type.namespace",
        "entity.name.namespace",
        "entity.name.type.module"
      ],
      "settings": {
        "foreground": "#C9D0FF"
      }
    },
    {
      "name": "Support Module",
      "scope": ["support.module", "support.module.node"],
      "settings": {
        "foreground": "#C9D0FF"
      }
    },
    {
      "name": "Variables",
      "scope": ["variable", "meta.definition.variable.name"],
      "settings": {
        "foreground": "#27F1FC"
      }
    },
    {
      "name": "Properties / Fields",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "variable.other.member",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#FFBECD"
      }
    },
    {
      "name": "Parameters",
      "scope": ["variable.parameter", "variable.parameter.function"],
      "settings": {
        "foreground": "#FFBECD"
      }
    },
    {
      "name": "Constants",
      "scope": ["variable.other.constant", "constant.language"],
      "settings": {
        "foreground": "#96E0FF"
      }
    },
    {
      "name": "Support Constants",
      "scope": ["support.constant", "constant.other"],
      "settings": {
        "foreground": "#96E0FF"
      }
    },
    {
      "name": "Language Variables",
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self"
      ],
      "settings": {
        "foreground": "#66F3D3",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Support Variable",
      "scope": ["support.variable", "support.variable.property"],
      "settings": {
        "foreground": "#69EBF3"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted.double",
        "string.quoted.single",
        "string.quoted.triple",
        "string.quoted.other"
      ],
      "settings": {
        "foreground": "#BCE498"
      }
    },
    {
      "name": "Template Strings",
      "scope": ["string.template", "string.interpolated"],
      "settings": {
        "foreground": "#BCE498"
      }
    },
    {
      "name": "String Punctuation",
      "scope": [
