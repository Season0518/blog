      "settings": {
        "foreground": "#BCE498"
      }
    },
    {
      "name": "Template Expression",
      "scope": [
        "punctuation.definition.template-expression",
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#FFB7FF"
      }
    },
    {
