        "fontStyle": "underline"
      }
    },
    {
      "name": "Markup Inserted",
      "scope": ["markup.inserted"],
      "settings": {
        "foreground": "#BCE498"
      }
    },
    {
      "name": "Markup Deleted",
      "scope": ["markup.deleted"],
      "settings": {
        "foreground": "#FF97CD"
      }
    },
    {
      "name": "Markup Changed",
      "scope": ["markup.changed"],
      "settings": {
