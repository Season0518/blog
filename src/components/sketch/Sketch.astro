---
import { Font } from "astro:assets";
import rough from "roughjs";
import type { Drawable, Options } from "roughjs/bin/core";
import type { Anchor, Point, SketchShape, Tone } from "./types";

export type { SketchShape };

interface Props {
  width: number;
  height: number;
  title: string;
  caption?: string;
  shapes: SketchShape[];
}

const { width, height, title, caption, shapes } = Astro.props;

type Path = {
  d: string;
  kind: "stroke" | "hatch" | "solid";
  dashed?: boolean;
  head?: boolean;
};
type Label = {
  x: number;
  y: number;
  text: string;
  size: number;
  anchor: Anchor;
  muted?: boolean;
};
type Group = { tone: Tone; paths: Path[]; labels: Label[] };
type IdentifiedGroup = Group & { id?: string; shape: SketchShape["type"] };

const generator = rough.generator();
const base: Options = {
  roughness: 1.1,
  bowing: 0.8,
  strokeWidth: 1.6,
  hachureGap: 7,
  hachureAngle: -41,
  fillWeight: 1,
};
const dashedOptions: Options = { disableMultiStroke: true, roughness: 0.7 };

const toPaths = (drawable: Drawable, dashed = false): Path[] =>
  drawable.sets.map(set => ({
    d: generator.opsToPath(set, 2),
    kind:
      set.type === "path"
        ? "stroke"
        : set.type === "fillPath"
          ? "solid"
          : "hatch",
    dashed: dashed && set.type === "path",
  }));

const roundedRect = (x: number, y: number, w: number, h: number) => {
  const r = Math.min(14, w / 4, h / 4);
  return [
    `M${x + r} ${y}H${x + w - r}Q${x + w} ${y} ${x + w} ${y + r}`,
    `V${y + h - r}Q${x + w} ${y + h} ${x + w - r} ${y + h}`,
    `H${x + r}Q${x} ${y + h} ${x} ${y + h - r}V${y + r}Q${x} ${y} ${x + r} ${y}Z`,
  ].join("");
};

const arrowHead = ([x1, y1]: Point, [x2, y2]: Point): Point[][] => {
  const angle = Math.atan2(y2 - y1, x2 - x1);
  const wing = (offset: number): Point => [
    x2 - 11 * Math.cos(angle + offset),
    y2 - 11 * Math.sin(angle + offset),
  ];
  return [wing(0.45), wing(-0.45)].map(point => [point, [x2, y2]]);
};

const label = (
  x: number,
  y: number,
  text: string,
  size: number,
  anchor: Anchor = "middle",
  muted = false
): Label => ({ x, y, text, size, anchor, muted });

const draw = (shape: SketchShape, seed: number): Group => {
  switch (shape.type) {
    case "box": {
      const { x, y, w, h, sub, tone = "plain", dashed = false } = shape;
      const fill: Options =
        tone === "accent" ? { fill: "accent", fillStyle: "hachure" } : {};
      const options = { ...base, ...fill, ...(dashed && dashedOptions), seed };
      const labelY = sub ? y + h / 2 - 3 : y + h / 2 + 6;
      return {
        tone,
        paths: toPaths(
          generator.path(roundedRect(x, y, w, h), options),
          dashed
        ),
        labels: [
          label(x + w / 2, labelY, shape.label, 18),
          ...(sub
            ? [label(x + w / 2, labelY + 20, sub, 13, "middle", true)]
            : []),
        ],
      };
    }
    case "frame": {
      const { x, y, w, h, labelAt = "top-left" } = shape;
      const right = labelAt === "bottom-right";
      const options = { ...base, ...dashedOptions, seed };
      return {
        tone: "muted",
        paths: toPaths(generator.path(roundedRect(x, y, w, h), options), true),
        labels: [
          label(
            right ? x + w - 14 : x + 14,
            labelAt === "top-left" ? y + 22 : y + h - 12,
            shape.label,
            14,
            right ? "end" : "start",
            true
          ),
        ],
      };
    }
    case "arrow": {
      const { points, dashed = false } = shape;
      const [from, to] = points.slice(-2);
      const [lx, ly] = shape.labelAt ?? to;
      const options = { ...base, ...(dashed && dashedOptions), seed };
      return {
        tone: "plain",
        paths: [
          ...toPaths(generator.linearPath(points, options), dashed),
          ...arrowHead(from, to).flatMap(line =>
            toPaths(
              generator.linearPath(line, { ...base, roughness: 0.6, seed })
            ).map(path => ({ ...path, head: true }))
          ),
        ],
        labels: shape.label
          ? [label(lx, ly, shape.label, 13, shape.labelAnchor, true)]
          : [],
      };
    }
    case "slab": {
      const { x, y, w, h, skew, holes, sub } = shape;
      const cy = y + h / 2;
      const labelY = sub ? cy - 3 : cy + 6;
      const labelX = x + w + skew + 24;
      const outline: Point[] = [
        [x, y + h],
        [x + w, y + h],
        [x + w + skew, y],
        [x + skew, y],
      ];
      return {
        tone: "plain",
        paths: [
          ...toPaths(
            generator.polygon(outline, {
              ...base,
              fill: "accent",
              fillStyle: "hachure",
              seed,
            })
          ),
          ...holes.flatMap((hole, i) =>
            toPaths(
              generator.ellipse(hole.x, cy, hole.w, h * 0.4, {
                ...base,
                roughness: 0.7,
                fill: "background",
                fillStyle: "solid",
                seed: seed * 10 + i,
              })
            )
          ),
        ],
        labels: [
          label(labelX, labelY, shape.label, 18, "start"),
          ...(sub ? [label(labelX, labelY + 20, sub, 13, "start", true)] : []),
        ],
      };
    }
    case "curve":
      return {
        tone: shape.tone ?? "plain",
        paths: toPaths(generator.curve(shape.points, { ...base, seed })),
        labels: [],
      };
    case "text":
      return {
        tone: "plain",
        paths: [],
        labels: [
          label(
            shape.x,
            shape.y,
            shape.text,
            shape.size ?? 14,
            shape.anchor ?? "start",
            shape.muted
          ),
        ],
      };
  }
};

const groups: IdentifiedGroup[] = shapes.map((shape, index) => ({
  id: shape.id,
  shape: shape.type,
  ...draw(shape, index + 1),
}));
---

<Font cssVariable="--font-sketch" />
<figure class="sketch not-prose my-8">
  <div class="overflow-x-auto">
    <svg
      viewBox={`0 0 ${width} ${height}`}
      role="img"
      aria-label={title}
      class="mx-auto block w-full min-w-[640px]"
      style={`max-width: ${width}px`}
    >
      <title>{title}</title>
      {
        groups.map(group => (
          <g
            class={`tone-${group.tone}`}
            data-id={group.id}
            data-shape={group.shape}
          >
            {group.paths.map(path => (
              <path
                d={path.d}
                class:list={[
                  path.kind,
                  { dashed: path.dashed, head: path.head },
                ]}
              />
            ))}
            {group.labels.map(item => (
              <text
                x={item.x}
                y={item.y}
                font-size={item.size}
                text-anchor={item.anchor}
                class:list={{ muted: item.muted }}
              >
                {item.text}
              </text>
            ))}
          </g>
        ))
      }
      <slot name="overlay" />
    </svg>
  </div>
  <slot />
  {
    caption && (
      <figcaption class="mt-3 text-center text-sm">{caption}</figcaption>
    )
  }
</figure>

<style>
  .sketch {
    color: var(--foreground);
  }

  svg {
    font-family: var(--font-sketch);
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  path {
    fill: none;
  }

  .stroke {
    stroke: currentColor;
  }

  .dashed {
    stroke-dasharray: 7 7;
  }

  .hatch {
    stroke: var(--accent);
    opacity: 0.35;
  }

  .solid {
    fill: var(--background);
  }

  .tone-accent .stroke {
    stroke: var(--accent);
  }

  .tone-muted .stroke {
    stroke: var(--muted-foreground);
    opacity: 0.7;
  }

  text {
    fill: currentColor;
    paint-order: stroke;
    stroke: var(--background);
    stroke-width: 4px;
  }

  text.muted,
  figcaption {
    fill: var(--muted-foreground);
    color: var(--muted-foreground);
  }

  figcaption {
    opacity: 1;
  }

  .sketch {
    --sketch-block: #c2185b;
    --sketch-warn: #b26a00;
    --sketch-dim: 0.3;
    --sketch-visited: 0.62;
  }

  :global([data-theme="dark"]) .sketch {
    --sketch-block: #f48fb1;
    --sketch-warn: #ffcc80;
    --sketch-dim: 0.22;
    --sketch-visited: 0.5;
  }

  g[data-id] {
    --state-color: var(--accent);
    transition: opacity 0.3s ease;
  }

  .sketch[data-playing] g[data-id] {
    opacity: var(--sketch-dim);
  }

  .sketch[data-playing] g[data-state] {
    opacity: 1;
  }

  .sketch[data-playing] g[data-state="visited"] {
    opacity: var(--sketch-visited);
  }

  g[data-state="block"] {
    --state-color: var(--sketch-block);
  }

  g[data-state="warn"] {
    --state-color: var(--sketch-warn);
  }

  g:is(
      [data-state="active"],
      [data-state="pass"],
      [data-state="block"],
      [data-state="warn"]
    )
    .stroke {
    stroke: var(--state-color);
    stroke-width: 2.4;
    opacity: 1;
  }

  g[data-shape="slab"][data-state="active"] .hatch {
    opacity: 0.6;
  }

  g:is([data-state="block"], [data-state="warn"]) .hatch {
    stroke: var(--state-color);
    opacity: 0.45;
  }

  g[data-shape="arrow"][data-state="active"] .stroke:not(.head) {
    stroke-dasharray: 8 6;
    animation: sketch-flow 0.7s linear infinite;
  }

  svg :global(.sketch-badge) {
    font-size: 15px;
    fill: var(--accent);
    paint-order: stroke;
    stroke: var(--background);
    stroke-width: 4px;
  }

  svg :global(.sketch-badge[data-state="block"]) {
    fill: var(--sketch-block);
  }

  svg :global(.sketch-badge[data-state="warn"]) {
    fill: var(--sketch-warn);
  }

  @keyframes sketch-flow {
    to {
      stroke-dashoffset: -14;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    g[data-id] {
      transition: none;
    }

    g[data-shape="arrow"][data-state="active"] .stroke:not(.head) {
      animation: none;
    }
  }
</style>
